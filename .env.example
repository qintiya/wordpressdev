# Copy to .env and change database credentials before use.
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=change-this-local-password
MARIADB_ROOT_PASSWORD=change-this-local-root-password

# Point DNS A/AAAA records for both names to the public IP of the Docker host.
WORDPRESS_DOMAIN=wp.awdev.eu.org
FRONTEND_DOMAIN=awdev.eu.org

# Optional local-only access, bound to 127.0.0.1 on the host.
WORDPRESS_PORT=8080
FRONTEND_PORT=3000

# Optional Django application (docker compose --profile django up --build).
DJANGO_PORT=8000
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
